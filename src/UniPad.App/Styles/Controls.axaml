<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Control styling that reproduces the Qt Widgets look: square-ish corners, thin borders,
    flat fills and a group box whose caption sits on the border line.
  -->

  <!-- ============ Window ============ -->
  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource WindowBackgroundBrush}" />
    <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeNormal}" />
  </Style>

  <!-- ============ Text ============ -->
  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeNormal}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="TextBlock.caption">
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
  </Style>

  <Style Selector="TextBlock.heading">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeLarge}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="TextBlock.groupLabel">
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>

  <!--
    Raw axis and button dumps only line up when every glyph has the same advance width, so the
    diagnostics monitor uses a fixed-pitch face.
  -->
  <Style Selector="TextBlock.mono">
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="FontFamily" Value="Consolas, Cascadia Mono, DejaVu Sans Mono, monospace" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
  </Style>

  <!-- ============ Button ============ -->
  <Style Selector="Button">
    <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource StandardCornerRadius}" />
    <Setter Property="Padding" Value="10,4" />
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeNormal}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>

  <Style Selector="Button:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
    <Setter Property="TextBlock.Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>

  <Style Selector="Button:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentPressedBrush}" />
    <Setter Property="TextBlock.Foreground" Value="White" />
  </Style>

  <Style Selector="Button:disabled /template/ ContentPresenter">
    <Setter Property="TextBlock.Foreground" Value="{DynamicResource TextDisabledBrush}" />
    <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
  </Style>

  <Style Selector="Button.accent">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentPressedBrush}" />
  </Style>

  <Style Selector="Button.accent:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
    <Setter Property="TextBlock.Foreground" Value="White" />
  </Style>

  <!-- Bind buttons are dense and monospace-ish so long labels stay readable. -->
  <Style Selector="Button.bind">
    <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
    <Setter Property="Padding" Value="4,2" />
    <Setter Property="MinHeight" Value="22" />
    <Setter Property="MinWidth" Value="62" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
  </Style>

  <Style Selector="Button.bind.capturing">
    <Setter Property="BorderBrush" Value="{DynamicResource CaptureBrush}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="Foreground" Value="{DynamicResource CaptureBrush}" />
  </Style>

  <Style Selector="Button.bind.active">
    <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}" />
    <Setter Property="Background" Value="{DynamicResource AccentPressedBrush}" />
  </Style>

  <!-- ============ Group box (Qt style: caption sits on the border) ============ -->
  <Style Selector="HeaderedContentControl.groupBox">
    <Setter Property="Margin" Value="3" />
    <Setter Property="Template">
      <ControlTemplate>
        <Grid RowDefinitions="8,*">
          <Border Grid.Row="0" Grid.RowSpan="2"
                  Background="{DynamicResource PanelBackgroundBrush}"
                  BorderBrush="{DynamicResource BorderBrush}"
                  BorderThickness="1"
                  CornerRadius="{DynamicResource StandardCornerRadius}" />

          <!-- Caption chip: an opaque background over the border creates the notched look. -->
          <Border Grid.Row="0"
                  Background="{DynamicResource PanelBackgroundBrush}"
                  HorizontalAlignment="Center"
                  Padding="6,0"
                  Margin="0,-1,0,0">
            <TextBlock Text="{TemplateBinding Header}"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       FontSize="{DynamicResource FontSizeSmall}" />
          </Border>

          <ContentPresenter Grid.Row="1"
                            Content="{TemplateBinding Content}"
                            Margin="6,4,6,6" />
        </Grid>
      </ControlTemplate>
    </Setter>
  </Style>

  <!-- ============ ComboBox ============ -->
  <Style Selector="ComboBox">
    <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource StandardCornerRadius}" />
    <Setter Property="Padding" Value="6,2" />
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeNormal}" />
  </Style>

  <Style Selector="ComboBox:pointerover /template/ Border#Background">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>

  <!-- ============ TextBox ============ -->
  <Style Selector="TextBox">
    <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource StandardCornerRadius}" />
    <Setter Property="Padding" Value="6,3" />
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>

  <!-- ============ CheckBox / RadioButton ============ -->
  <Style Selector="CheckBox">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeNormal}" />
    <Setter Property="MinHeight" Value="20" />
    <Setter Property="Padding" Value="6,0,0,0" />
  </Style>

  <Style Selector="RadioButton">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeNormal}" />
    <Setter Property="MinHeight" Value="20" />
    <Setter Property="Padding" Value="6,0,0,0" />
  </Style>

  <!-- ============ Slider (thin Qt-like track) ============ -->
  <Style Selector="Slider">
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Height" Value="20" />
    <Setter Property="Margin" Value="0" />
  </Style>

  <Style Selector="Slider /template/ Track#PART_Track">
    <Setter Property="Height" Value="4" />
  </Style>

  <Style Selector="Slider /template/ Thumb">
    <Setter Property="Width" Value="12" />
    <Setter Property="Height" Value="12" />
  </Style>

  <!-- ============ TabControl (yuzu's flat tab strip) ============ -->
  <Style Selector="TabControl">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0" />
  </Style>

  <Style Selector="TabItem">
    <Setter Property="Background" Value="{DynamicResource TabStripBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeNormal}" />
    <Setter Property="Padding" Value="12,5" />
    <Setter Property="MinHeight" Value="26" />
    <Setter Property="Margin" Value="0,0,1,0" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1,1,1,0" />
    <Setter Property="CornerRadius" Value="3,3,0,0" />
  </Style>

  <Style Selector="TabItem:selected">
    <Setter Property="Background" Value="{DynamicResource TabSelectedBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>

  <Style Selector="TabItem:pointerover /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource TabSelectedBackgroundBrush}" />
  </Style>

  <!-- ============ ListBox (settings sidebar) ============ -->
  <Style Selector="ListBox.sidebar">
    <Setter Property="Background" Value="{DynamicResource SidebarBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="0" />
  </Style>

  <Style Selector="ListBox.sidebar ListBoxItem">
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="MinHeight" Value="22" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeNormal}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>

  <Style Selector="ListBox.sidebar ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="TextBlock.Foreground" Value="White" />
  </Style>

  <!-- ============ Separator / status bar ============ -->
  <Style Selector="Border.statusBar">
    <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="Padding" Value="8,4" />
  </Style>

  <Style Selector="Border.banner">
    <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource StandardCornerRadius}" />
    <Setter Property="Padding" Value="10,6" />
  </Style>

  <!-- ============ ScrollViewer ============ -->
  <Style Selector="ScrollViewer">
    <Setter Property="Background" Value="Transparent" />
  </Style>

</Styles>
